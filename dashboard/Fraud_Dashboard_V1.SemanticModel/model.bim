          },
          {
            "name": "IsFraud",
            "dataType": "int64",
            "lineageTag": "c496536c-4747-406f-b652-cd5893514a28",
            "sourceColumn": "IsFraud",
            "summarizeBy": "none"
          },
          {
            "name": "Class",
            "dataType": "string",
            "lineageTag": "115931e1-77c3-4f2a-a2d5-72b7a62b7ed8",
            "sourceColumn": "Class",
            "summarizeBy": "none"
          },
          {
            "name": "AccountEmptied",
            "dataType": "string",
            "lineageTag": "25f01405-4679-414a-a235-fbeb9793865c",
            "sourceColumn": "AccountEmptied",
            "summarizeBy": "none"
          },
          {
            "name": "WholeBalanceMoved",
            "dataType": "string",
            "lineageTag": "bf13730d-3317-4913-a7ad-58b9b7fbfa29",
            "sourceColumn": "WholeBalanceMoved",
            "summarizeBy": "none"
          },
          {
            "name": "AmountBand",
            "dataType": "string",
            "lineageTag": "0ee5aea6-e7e0-49a8-b0d4-651f87f0f5ca",
            "sourceColumn": "AmountBand",
            "summarizeBy": "none"
          },
          {
            "name": "HourPeriod",
            "dataType": "string",
            "lineageTag": "fb2c8a5f-e4d5-4182-8fcb-2c21152a1c9a",
            "sourceColumn": "HourPeriod",
            "summarizeBy": "none"
          },
          {
            "name": "Split",
            "dataType": "string",
            "lineageTag": "09945c3d-f99f-4569-b027-c87c8dec7a4a",
            "sourceColumn": "Split",
            "summarizeBy": "none"
          },
          {
            "name": "FraudProbability",
            "dataType": "double",
            "formatString": "0.0000",
            "lineageTag": "577e762a-14b1-4891-bf00-42050c894418",
            "sourceColumn": "FraudProbability",
            "summarizeBy": "none"
          },
          {
            "name": "Predicted",
            "dataType": "string",
            "lineageTag": "351463bd-f263-4e2d-8a68-22add7e2d4d0",
            "sourceColumn": "Predicted",
            "summarizeBy": "none"
          },
          {
            "name": "Outcome",
            "dataType": "string",
            "lineageTag": "e9fdeaad-3714-4cc4-8e5e-763a166b85d0",
            "sourceColumn": "Outcome",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "b621590d-753a-4099-855f-c5a71ee7993e",
        "measures": [
          {
            "name": "Transactions",
            "expression": "COUNTROWS(transactions)",
            "formatString": "#,##0",
            "lineageTag": "ed61c8b0-48c4-468b-a2e4-e9e4f0166238"
          },
          {
            "name": "Fraud Cases",
            "expression": "CALCULATE(COUNTROWS(transactions), transactions[IsFraud] = 1)",
            "formatString": "#,##0",
            "lineageTag": "aa4b3c1c-07f7-4e1a-996c-8e0b49f457a1"
          },
          {
            "name": "Fraud Rate",
            "expression": "DIVIDE([Fraud Cases], [Transactions])",
            "formatString": "0.00%",
            "lineageTag": "0d5e2bc9-248c-4628-a351-b3f7fa9b6ef4"
          },
          {
            "name": "Total Amount",
            "expression": "SUM(transactions[Amount])",
            "formatString": "#,##0",
            "lineageTag": "2ee06bd5-2009-4557-b59b-15501dd97b61"
          },
          {
            "name": "Fraud Amount",
            "expression": "CALCULATE(SUM(transactions[Amount]), transactions[IsFraud] = 1)",
            "formatString": "#,##0",
            "lineageTag": "25ea9d6e-7172-45dc-aac5-589bc9553ae3"
          },
          {
            "name": "Fraud Share of Money",
            "expression": "DIVIDE([Fraud Amount], [Total Amount])",
            "formatString": "0.0%",
            "lineageTag": "5bac3f1e-83ac-4961-8c43-e8bab53f9f53"
          },
          {
            "name": "Account Emptied Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(transactions), transactions[AccountEmptied] = \"Yes\"), [Transactions])",
            "formatString": "0.0%",
            "lineageTag": "fbb4cd81-716f-490f-b3d6-0c109e18ab3c"
          },
          {
            "name": "Whole Balance Moved Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(transactions), transactions[WholeBalanceMoved] = \"Yes\") + 0, [Transactions])",
            "formatString": "0.0%",
            "lineageTag": "f4f50e72-b1fc-4a69-a46f-a4cd32831f79"
          },
          {
            "name": "Fraud Caught",
            "expression": "CALCULATE(COUNTROWS(transactions), transactions[Split] = \"Test\", transactions[Outcome] = \"Fraud caught\")",
            "formatString": "#,##0",
            "lineageTag": "7a0a6d92-7ba2-479a-bfd0-4114436caea4"
          },
          {
            "name": "Missed Fraud",
            "expression": "CALCULATE(COUNTROWS(transactions), transactions[Split] = \"Test\", transactions[Outcome] = \"Missed fraud\")",
            "formatString": "#,##0",
            "lineageTag": "e86d4b2b-2093-4ef8-b3f2-3fc644c7e91e"
          },
          {
            "name": "False Alarms",
            "expression": "CALCULATE(COUNTROWS(transactions), transactions[Split] = \"Test\", transactions[Outcome] = \"False alarm\")",
            "formatString": "#,##0",
            "lineageTag": "2fde321f-272d-4ef4-af50-7c5175436a03"
          },
          {
            "name": "Correct Normal",
            "expression": "CALCULATE(COUNTROWS(transactions), transactions[Split] = \"Test\", transactions[Outcome] = \"Correct normal\")",
            "formatString": "#,##0",
            "lineageTag": "a95198cd-1d1b-4255-abfb-ba85ec86a30e"
          },
          {
            "name": "Precision",
            "expression": "DIVIDE([Fraud Caught], [Fraud Caught] + [False Alarms])",
            "formatString": "0.000",
            "lineageTag": "e4eb0569-f766-4536-bc25-5f50697b23b4"
          },
          {
            "name": "Recall",
            "expression": "DIVIDE([Fraud Caught], [Fraud Caught] + [Missed Fraud])",
            "formatString": "0.000",
            "lineageTag": "b67d2165-c0a3-4773-b384-24ef4dcd72ca"
          },
          {
            "name": "F1 Score",
            "expression": "DIVIDE(2 * [Precision] * [Recall], [Precision] + [Recall])",
            "formatString": "0.000",
            "lineageTag": "2387022d-a844-4077-a654-e72582cd4b04"
          }
        ],
        "partitions": [
          {
            "name": "transactions",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"transactions.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"TxnID\", Int64.Type}, {\"Hour\", Int64.Type}, {\"Type\", type text}, {\"Amount\", type number}, {\"SenderBalanceBefore\", type number}, {\"SenderBalanceAfter\", type number}, {\"ReceiverBalanceBefore\", type number}, {\"ReceiverBalanceAfter\", type number}, {\"ReceiverKind\", type text}, {\"IsFraud\", Int64.Type}, {\"Class\", type text}, {\"AccountEmptied\", type text}, {\"WholeBalanceMoved\", type text}, {\"AmountBand\", type text}, {\"HourPeriod\", type text}, {\"Split\", type text}, {\"FraudProbability\", type number}, {\"Predicted\", type text}, {\"Outcome\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "model_comparison",
        "columns": [
          {
