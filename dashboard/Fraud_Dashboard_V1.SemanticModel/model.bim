            "summarizeBy": "none"
          },
          {
            "name": "ReceiverBalanceBefore",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "93c63dd5-c795-4647-b636-7403cf1e1c93",
            "sourceColumn": "ReceiverBalanceBefore",
            "summarizeBy": "none"
          },
          {
            "name": "ReceiverBalanceAfter",
            "dataType": "double",
            "formatString": "#,##0.00",
            "lineageTag": "482c246f-5c49-4188-bc8e-53af4e734f67",
            "sourceColumn": "ReceiverBalanceAfter",
            "summarizeBy": "none"
          },
          {
            "name": "ReceiverKind",
