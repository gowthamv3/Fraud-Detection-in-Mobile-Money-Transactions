        "partitions": [
          {
            "name": "model_comparison",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"model_comparison.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Model\", type text}, {\"Precision\", type number}, {\"Recall\", type number}, {\"F1\", type number}, {\"PR_AUC\", type number}, {\"FalseAlarms\", Int64.Type}, {\"MissedFraud\", Int64.Type}}, \"en-US\")",
                "in",
